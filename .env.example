# ---- Database (required) ----
# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.).
# The app creates its own tables on first run.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ---- Auth (required) ----
# Secret used to sign session tokens. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Google sign-in (optional — leave blank to hide the Google button and use
# only email + password). Create credentials at https://console.cloud.google.com
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- AI advisor (optional) ----
# When set, the advisor uses the Claude API for natural-language advice.
# Without it, the app falls back to built-in rule-based advice, so the
# dashboard works out of the box.
ANTHROPIC_API_KEY=
# Override the model if you like (defaults to a current Claude model).
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Telegram (optional, for the "texts you like a person" feature) ----
# Create a bot with @BotFather to get this token.
TELEGRAM_BOT_TOKEN=
# Your chat id (message @userinfobot to find it). The advisor sends
# proactive nudges and answers here.
TELEGRAM_CHAT_ID=
# A secret you choose; Telegram includes it on webhook calls so we can
# verify the request really came from Telegram.
TELEGRAM_WEBHOOK_SECRET=
# The bot answers for one account — set this to the email you sign in with.
TELEGRAM_OWNER_EMAIL=

# ---- App config ----
# Purchases at or above this amount trigger a proactive advisor reaction.
BIG_PURCHASE_THRESHOLD=200
