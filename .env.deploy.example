# Copy this to `.env` on your VPS and fill it in, then run:
#   docker compose up -d --build

# Your domain (DNS A-record must point to this VPS). Caddy gets HTTPS for it.
DOMAIN=fin.example.com

# Postgres password (choose any strong value — used only inside docker)
POSTGRES_PASSWORD=change-me-to-something-long

# Session signing secret. Generate with:  openssl rand -base64 32
AUTH_SECRET=

# ---- Optional ----
# Google sign-in (redirect URI: https://<DOMAIN>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Full AI advisor (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_EMAIL=

BIG_PURCHASE_THRESHOLD=200
